# Gorelo base URL — e.g. https://api.usw.gorelo.io  (NOTE: no trailing /v1; paths in spec already include /v1)
GORELO_BASE_URL=https://api.usw.gorelo.io

# API key — from Gorelo Settings > API Keys
# Provide EITHER GORELO_API_KEY (inline) OR GORELO_API_KEY_FILE (path to file containing the key).
# No default file path. One of the two must be set explicitly. GORELO_API_KEY wins if both set.
GORELO_API_KEY=

# Optional: read API key from a file. Tilde (~) expanded. No default path.
GORELO_API_KEY_FILE=

# Optional: override bundled swagger.json
GORELO_SWAGGER_PATH=

# Optional: comma-separated operationIds to disable (e.g. "delete_ticket,delete_contact")
GORELO_DISABLED_OPERATIONS=

# Optional: block all DELETE operations
GORELO_READONLY=false

# Optional: request timeout in ms (default 30000)
GORELO_TIMEOUT_MS=30000

# Optional: max retries on HTTP 429 (default 3). Respects Retry-After header.
GORELO_MAX_RETRIES=3

# Optional: max response body size in bytes; larger responses are truncated to prevent context blow-up (default 1500000)
GORELO_MAX_RESPONSE_BYTES=1500000

# Optional: preset to narrow the tool surface. Valid: all, readonly, crm, tickets, monitoring
GORELO_PRESET=

# Optional: whitelist tags (comma-separated, case-insensitive). Intersects with preset.
GORELO_ENABLE_TAGS=

# Optional: blacklist tags (comma-separated, case-insensitive). Subtracts after preset/enable.
GORELO_DISABLE_TAGS=
